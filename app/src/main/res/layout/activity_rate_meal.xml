<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rateMealScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:windowBackground"
    android:fillViewport="true"
    android:scrollbars="vertical"
    tools:context=".activities.RateMealActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp"
        android:paddingBottom="30dp">

        <!-- Header -->

        <TextView
            android:id="@+id/txtRateTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Rate this meal"
            android:textColor="?android:textColorPrimary"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/txtRateSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Your feedback helps improve your recommendations."
            android:textColor="?android:textColorSecondary"
            android:textSize="12sp" />

        <!-- Meal Card -->

        <LinearLayout
            android:id="@+id/ratedMealCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_light_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtRatedMealName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/playfair_display_bold"
                android:text="Paneer Butter Masala"
                android:textColor="?android:textColorPrimary"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/txtRatedMealCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/montserrat_medium"
                android:text="Main Course"
                android:textColor="?android:textColorSecondary"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- Overall Rating -->

        <TextView
            android:id="@+id/txtOverallTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Overall Rating"
            android:textColor="?android:textColorPrimary"
            android:textSize="21sp" />

        <RatingBar
            android:id="@+id/ratingOverall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:numStars="5"
            android:rating="0"
            android:stepSize="1"
            android:scaleX="1.15"
            android:scaleY="1.15" />

        <TextView
            android:id="@+id/txtRatingHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:fontFamily="@font/montserrat_medium"
            android:text="Tap to rate your overall experience"
            android:textColor="?android:textColorSecondary"
            android:textSize="10sp" />

        <!-- Taste -->

        <TextView
            android:id="@+id/txtTasteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Taste"
            android:textColor="?android:textColorPrimary"
            android:textSize="18sp" />

        <SeekBar
            android:id="@+id/seekTaste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:max="5"
            android:progress="3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_medium"
                android:text="Needs improvement"
                android:textColor="?android:textColorSecondary"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_medium"
                android:text="Excellent"
                android:textColor="?android:textColorSecondary"
                android:textSize="9sp" />

        </LinearLayout>

        <!-- Quality -->

        <TextView
            android:id="@+id/txtQualityTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Quality"
            android:textColor="?android:textColorPrimary"
            android:textSize="18sp" />

        <SeekBar
            android:id="@+id/seekQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:max="5"
            android:progress="3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_medium"
                android:text="Needs improvement"
                android:textColor="?android:textColorSecondary"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_medium"
                android:text="Excellent"
                android:textColor="?android:textColorSecondary"
                android:textSize="9sp" />

        </LinearLayout>

        <!-- Quantity -->

        <TextView
            android:id="@+id/txtQuantityTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Quantity"
            android:textColor="?android:textColorPrimary"
            android:textSize="18sp" />

        <SeekBar
            android:id="@+id/seekQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:max="5"
            android:progress="3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_medium"
                android:text="Too little"
                android:textColor="?android:textColorSecondary"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_medium"
                android:text="Just right"
                android:textColor="?android:textColorSecondary"
                android:textSize="9sp" />

        </LinearLayout>

        <!-- Feedback -->

        <TextView
            android:id="@+id/txtFeedbackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Your Feedback"
            android:textColor="?android:textColorPrimary"
            android:textSize="21sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/feedbackInputLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:hint="Tell us what you think..."
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtFeedback"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:gravity="top"
                android:fontFamily="@font/montserrat_medium"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="300"
                android:textSize="12sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Submit -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitRating"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Submit Rating"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:background="@drawable/bg_light_primary_button"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            app:strokeWidth="0dp" />

        <TextView
            android:id="@+id/txtRatingNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:fontFamily="@font/montserrat_medium"
            android:text="Your rating will help personalize future meal recommendations."
            android:textColor="?android:textColorSecondary"
            android:textSize="9sp" />

    </LinearLayout>

</ScrollView>