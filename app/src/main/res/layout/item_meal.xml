<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardMealItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_light_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtMealName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Paneer Butter Masala"
            android:textColor="?android:textColorPrimary"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/txtMealRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_semibold"
            android:text="4.6"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/txtMealCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/montserrat_medium"
        android:text="Main Course · Vegetarian"
        android:textColor="?android:textColorSecondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/txtMealDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/montserrat_medium"
        android:lineSpacingExtra="2dp"
        android:text="A rich and creamy paneer curry."
        android:textColor="?android:textColorSecondary"
        android:textSize="12sp" />

</LinearLayout>
