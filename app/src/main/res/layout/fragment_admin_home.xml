<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adminHomeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:windowBackground"
    android:fillViewport="true"
    android:scrollbars="vertical"
    tools:context=".fragments.AdminHomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp"
        android:paddingBottom="32dp">

        <!-- Header -->

        <TextView
            android:id="@+id/txtAdminHomeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Welcome, Admin"
            android:textColor="?android:textColorPrimary"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/txtAdminHomeSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Here's what is happening in your mess today."
            android:textColor="?android:textColorSecondary"
            android:textSize="12sp" />

        <!-- Today's Summary -->

        <TextView
            android:id="@+id/txtTodaySummaryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Today's Summary"
            android:textColor="?android:textColorPrimary"
            android:textSize="21sp" />

        <LinearLayout
            android:id="@+id/adminSummaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_light_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Meals -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtHomeMealCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/playfair_display_bold"
                        android:text="12"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:text="Meals Today"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="9sp" />

                </LinearLayout>

                <!-- Ratings -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtHomeRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/playfair_display_bold"
                        android:text="4.3"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:text="Avg Rating"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="9sp" />

                </LinearLayout>

                <!-- Feedback -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtHomeFeedbackCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/playfair_display_bold"
                        android:text="24"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:text="New Feedback"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="9sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Menu Status -->

        <TextView
            android:id="@+id/txtMenuStatusTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Menu Status"
            android:textColor="?android:textColorPrimary"
            android:textSize="21sp" />

        <LinearLayout
            android:id="@+id/menuStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_light_card"
            android:orientation="vertical"
            android:padding="17dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtBreakfastStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Breakfast    Aloo Paratha"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="Ready"
                    android:textColor="?attr/colorAccent"
                    android:textSize="9sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:alpha="0.15"
                android:background="?android:textColorSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtLunchStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Lunch    Paneer Butter Masala"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="Ready"
                    android:textColor="?attr/colorAccent"
                    android:textSize="9sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:alpha="0.15"
                android:background="?android:textColorSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtDinnerStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Dinner    Dal Makhani"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="Ready"
                    android:textColor="?attr/colorAccent"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Quick Actions -->

        <TextView
            android:id="@+id/txtAdminQuickActionsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Quick Actions"
            android:textColor="?android:textColorPrimary"
            android:textSize="21sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHomeManageMenu"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_light_outline"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Manage Today's Menu"
            android:textAllCaps="false"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHomeAddMeal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_light_outline"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Add New Meal"
            android:textAllCaps="false"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHomeAnalytics"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/montserrat_semibold"
            android:text="View Analytics"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="12dp"
            app:strokeWidth="0dp" />

        <!-- Latest Feedback -->

        <TextView
            android:id="@+id/txtLatestFeedbackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Latest Feedback"
            android:textColor="?android:textColorPrimary"
            android:textSize="21sp" />

        <LinearLayout
            android:id="@+id/latestFeedbackCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_light_card"
            android:orientation="vertical"
            android:padding="17dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtLatestFeedbackMeal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/playfair_display_bold"
                    android:text="Paneer Butter Masala"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtLatestFeedbackRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="5 / 5"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtLatestFeedbackComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="@font/montserrat_medium"
                android:lineSpacingExtra="2dp"
                android:text="Really good today. The taste and quantity were great."
                android:textColor="?android:textColorSecondary"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>