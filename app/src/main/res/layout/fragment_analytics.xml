<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/analyticsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:windowBackground"
    android:fillViewport="true"
    android:scrollbars="vertical"
    tools:context=".fragments.AnalyticsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp"
        android:paddingBottom="32dp">

        <!-- Header -->

        <TextView
            android:id="@+id/txtAnalyticsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Analytics"
            android:textColor="?android:textColorPrimary"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/txtAnalyticsSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Understand how students are experiencing their meals."
            android:textColor="?android:textColorSecondary"
            android:textSize="12sp" />

        <!-- Overall Performance -->

        <TextView
            android:id="@+id/txtPerformanceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Overall Performance"
            android:textColor="?android:textColorPrimary"
            android:textSize="21sp" />

        <LinearLayout
            android:id="@+id/performanceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_light_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtAnalyticsAverage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/playfair_display_bold"
                        android:text="4.3"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:text="Average Rating"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="10sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTotalRatings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/playfair_display_bold"
                        android:text="128"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="25sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:text="Total Ratings"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Rating Breakdown -->

        <TextView
            android:id="@+id/txtBreakdownTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Rating Breakdown"
            android:textColor="?android:textColorPrimary"
            android:textSize="21sp" />

        <LinearLayout
            android:id="@+id/ratingBreakdownCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_light_card"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- 5 Star -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="5 star"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="9sp" />

                <ProgressBar
                    android:id="@+id/progressFiveStar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="7dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="62"
                    android:progressTint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/txtFiveStarPercent"
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="62%"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- 4 Star -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="4 star"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="9sp" />

                <ProgressBar
                    android:id="@+id/progressFourStar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="7dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="24"
                    android:progressTint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/txtFourStarPercent"
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="24%"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- 3 Star -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="3 star"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="9sp" />

                <ProgressBar
                    android:id="@+id/progressThreeStar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="7dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="9"
                    android:progressTint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/txtThreeStarPercent"
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="9%"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- 2 Star -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="2 star"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="9sp" />

                <ProgressBar
                    android:id="@+id/progressTwoStar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="7dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="3"
                    android:progressTint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/txtTwoStarPercent"
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="3%"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- 1 Star -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="1 star"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="9sp" />

                <ProgressBar
                    android:id="@+id/progressOneStar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="7dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="2"
                    android:progressTint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/txtOneStarPercent"
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="2%"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Category Insights -->

        <TextView
            android:id="@+id/txtCategoryInsightsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Meal Insights"
            android:textColor="?android:textColorPrimary"
            android:textSize="21sp" />

        <LinearLayout
            android:id="@+id/mealInsightsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_light_card"
            android:orientation="vertical"
            android:padding="17dp">

            <TextView
                android:id="@+id/txtTopRatedMeal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_semibold"
                android:text="Top Rated Meal"
                android:textColor="?android:textColorSecondary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/txtTopRatedMealValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/playfair_display_bold"
                android:text="Paneer Butter Masala  •  4.6"
                android:textColor="?android:textColorPrimary"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:alpha="0.15"
                android:background="?android:textColorSecondary" />

            <TextView
                android:id="@+id/txtNeedsAttention"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_semibold"
                android:text="Needs Attention"
                android:textColor="?android:textColorSecondary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/txtNeedsAttentionValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/playfair_display_bold"
                android:text="Mixed Vegetable Curry  •  3.1"
                android:textColor="?android:textColorPrimary"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Feedback Summary -->

        <TextView
            android:id="@+id/txtFeedbackSummaryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Feedback Summary"
            android:textColor="?android:textColorPrimary"
            android:textSize="21sp" />

        <LinearLayout
            android:id="@+id/feedbackSummaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_light_card"
            android:orientation="vertical"
            android:padding="17dp">

            <TextView
                android:id="@+id/txtPositiveFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_medium"
                android:lineSpacingExtra="3dp"
                android:text="Students are responding positively to the current lunch menu, especially taste and variety."
                android:textColor="?android:textColorSecondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtFeedbackAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/montserrat_semibold"
                android:text="Use feedback to improve future menus."
                android:textColor="?attr/colorPrimary"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>