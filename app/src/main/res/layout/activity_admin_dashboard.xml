<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adminDashboardScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:windowBackground"
    android:fillViewport="true"
    android:scrollbars="vertical"
    tools:context=".activities.AdminDashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp"
        android:paddingBottom="32dp">

        <!-- Header -->

        <TextView
            android:id="@+id/txtAdminDashboardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Admin Dashboard"
            android:textColor="?android:textColorPrimary"
            android:textSize="29sp" />

        <TextView
            android:id="@+id/txtAdminDashboardSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Manage your mess at a glance."
            android:textColor="?android:textColorSecondary"
            android:textSize="12sp" />

        <!-- Overview -->

        <TextView
            android:id="@+id/txtOverviewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Overview"
            android:textColor="?android:textColorPrimary"
            android:textSize="21sp" />

        <LinearLayout
            android:id="@+id/overviewRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Meals Today -->

            <LinearLayout
                android:id="@+id/mealsOverviewCard"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_light_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:id="@+id/txtMealsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/playfair_display_bold"
                    android:text="12"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="27sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Meals Today"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- Average Rating -->

            <LinearLayout
                android:id="@+id/ratingOverviewCard"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_light_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:id="@+id/txtAverageRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/playfair_display_bold"
                    android:text="4.3"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="27sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Average Rating"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Today's Menu -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtAdminMenuTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/playfair_display_bold"
                android:text="Today's Menu"
                android:textColor="?android:textColorPrimary"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/txtManageMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_semibold"
                android:text="Manage"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/adminMenuCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_light_card"
            android:orientation="vertical"
            android:padding="17dp">

            <!-- Breakfast -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="Breakfast"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/txtAdminBreakfast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Aloo Paratha"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="11sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="13dp"
                android:layout_marginBottom="13dp"
                android:alpha="0.15"
                android:background="?android:textColorSecondary" />

            <!-- Lunch -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="Lunch"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/txtAdminLunch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Paneer Butter Masala"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="11sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="13dp"
                android:layout_marginBottom="13dp"
                android:alpha="0.15"
                android:background="?android:textColorSecondary" />

            <!-- Dinner -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="Dinner"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/txtAdminDinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Dal Makhani"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Quick Actions -->

        <TextView
            android:id="@+id/txtQuickActionsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Quick Actions"
            android:textColor="?android:textColorPrimary"
            android:textSize="21sp" />

        <!-- Manage Menu -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManageMenu"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_light_outline"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Manage Menu"
            android:textAllCaps="false"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            app:strokeWidth="0dp" />

        <!-- Add Meal -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddMeal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_light_outline"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Add Meal"
            android:textAllCaps="false"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            app:strokeWidth="0dp" />

        <!-- Analytics -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewAnalytics"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/montserrat_semibold"
            android:text="View Analytics"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="12dp"
            app:strokeWidth="0dp" />

        <!-- Recent Feedback -->

        <TextView
            android:id="@+id/txtRecentFeedbackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Recent Feedback"
            android:textColor="?android:textColorPrimary"
            android:textSize="21sp" />

        <LinearLayout
            android:id="@+id/recentFeedbackCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_light_card"
            android:orientation="vertical"
            android:padding="17dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtFeedbackMeal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/playfair_display_bold"
                    android:text="Paneer Butter Masala"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txtFeedbackRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="5 / 5"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtFeedbackComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/montserrat_medium"
                android:lineSpacingExtra="2dp"
                android:text="Really good today. The taste and quantity were great."
                android:textColor="?android:textColorSecondary"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Sign Out -->

        <TextView
            android:id="@+id/txtAdminLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Sign Out"
            android:textColor="?attr/colorError"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>