<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/manageMealScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:windowBackground"
    android:fillViewport="true"
    android:scrollbars="vertical"
    tools:context=".activities.ManageMealActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp"
        android:paddingBottom="32dp">

        <!-- Header -->

        <TextView
            android:id="@+id/txtManageMealTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Manage Meal"
            android:textColor="?android:textColorPrimary"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/txtManageMealSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Add a new meal or update an existing one."
            android:textColor="?android:textColorSecondary"
            android:textSize="12sp" />

        <!-- Meal Information -->

        <TextView
            android:id="@+id/txtMealInformationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Meal Information"
            android:textColor="?android:textColorPrimary"
            android:textSize="21sp" />

        <!-- Meal Name -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/mealNameLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Meal name"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtMealName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_medium"
                android:inputType="textCapWords"
                android:textSize="12sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Category -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/categoryLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Category"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtMealCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_medium"
                android:inputType="textCapWords"
                android:textSize="12sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Description -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/descriptionLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Description"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtMealDescription"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:fontFamily="@font/montserrat_medium"
                android:gravity="top"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="300"
                android:textSize="12sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Food Type -->

        <TextView
            android:id="@+id/txtMealFoodTypeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Food Type"
            android:textColor="?android:textColorPrimary"
            android:textSize="20sp" />

        <RadioGroup
            android:id="@+id/radioMealFoodType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioMealVeg"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_medium"
                android:text="Vegetarian"
                android:textColor="?android:textColorPrimary"
                android:textSize="10sp"
                android:buttonTint="?attr/colorPrimary" />

            <RadioButton
                android:id="@+id/radioMealEgg"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_medium"
                android:text="Eggetarian"
                android:textColor="?android:textColorPrimary"
                android:textSize="10sp"
                android:buttonTint="?attr/colorPrimary" />

            <RadioButton
                android:id="@+id/radioMealNonVeg"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_medium"
                android:text="Non-Veg"
                android:textColor="?android:textColorPrimary"
                android:textSize="10sp"
                android:buttonTint="?attr/colorPrimary" />

        </RadioGroup>

        <!-- Spice Level -->

        <TextView
            android:id="@+id/txtMealSpiceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Spice Level"
            android:textColor="?android:textColorPrimary"
            android:textSize="20sp" />

        <RadioGroup
            android:id="@+id/radioMealSpice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioMealMild"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_medium"
                android:text="Mild"
                android:textColor="?android:textColorPrimary"
                android:textSize="10sp"
                android:buttonTint="?attr/colorPrimary" />

            <RadioButton
                android:id="@+id/radioMealMedium"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_medium"
                android:text="Medium"
                android:textColor="?android:textColorPrimary"
                android:textSize="10sp"
                android:buttonTint="?attr/colorPrimary" />

            <RadioButton
                android:id="@+id/radioMealSpicy"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_medium"
                android:text="Spicy"
                android:textColor="?android:textColorPrimary"
                android:textSize="10sp"
                android:buttonTint="?attr/colorPrimary" />

        </RadioGroup>

        <!-- Meal Tags -->

        <TextView
            android:id="@+id/txtMealTagsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Meal Tags"
            android:textColor="?android:textColorPrimary"
            android:textSize="20sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/mealTagsLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:hint="Tags"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtMealTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_medium"
                android:inputType="text"
                android:textSize="12sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/txtMealTagsHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Example: creamy, paneer, north-indian"
            android:textColor="?android:textColorSecondary"
            android:textSize="9sp" />

        <!-- Availability -->

        <LinearLayout
            android:id="@+id/availabilityRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtAvailabilityTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/playfair_display_bold"
                    android:text="Available"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/txtAvailabilitySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Show this meal in the menu."
                    android:textColor="?android:textColorSecondary"
                    android:textSize="9sp" />

            </LinearLayout>

            <Switch
                android:id="@+id/switchMealAvailable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:buttonTint="?attr/colorPrimary"
                android:text="" />

        </LinearLayout>

        <!-- Save -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveMeal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Save Meal"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="12dp"
            app:strokeWidth="0dp" />

        <TextView
            android:id="@+id/txtManageMealNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:fontFamily="@font/montserrat_medium"
            android:text="Meal details can be updated anytime."
            android:textColor="?android:textColorSecondary"
            android:textSize="9sp" />

    </LinearLayout>

</ScrollView>