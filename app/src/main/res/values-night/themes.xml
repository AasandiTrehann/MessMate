<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MessMate" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Brand Colors -->
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorPrimaryVariant">@color/dark_secondary</item>
        <item name="colorOnPrimary">@color/black</item>

        <item name="colorSecondary">@color/dark_secondary</item>
        <item name="colorSecondaryVariant">@color/dark_highlight</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- App Background -->
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:colorBackground">@color/dark_background</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/dark_text_primary</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>

        <!-- Light icons on dark system bars -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Disable default ActionBar -->
        <item name="windowActionModeOverlay">true</item>

    </style>

    <style name="Theme.MessMate.Splash" parent="Theme.MessMate">
        <item name="android:windowBackground">@color/light_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
